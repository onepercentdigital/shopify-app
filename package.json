{
  "name": "shopify-app",
  "private": true,
  "repository": "https://github.com/onepercentdigital/shopify-app.git",
  "packageManager": "bun@1.3.5",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build && tsc --noEmit",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "cf-typegen": "wrangler types",
    "type": "tsc --noEmit",
    "check": "biome check",
    "fix": "biome check --write",
    "fix-unsafe": "biome check --write --unsafe",
    "check-all": "tsc --noEmit && biome check"
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.20.1",
    "@headlessui/react": "^2.2.9",
    "@heroicons/react": "^2.2.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.90.16",
    "@tanstack/react-router": "^1.146.2",
    "@tanstack/react-router-ssr-query": "^1.146.2",
    "@tanstack/react-start": "^1.146.3",
    "@tanstack/router-plugin": "^1.146.3",
    "@unpic/react": "^1.0.2",
    "clsx": "^2.1.1",
    "geist": "^1.5.1",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.1.18",
    "vite-tsconfig-paths": "^5.1.4",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.11",
    "@tanstack/devtools-vite": "^0.4.1",
    "@types/node": "^24.10.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.58.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "sharp",
    "workerd",
    "esbuild"
  ]
}
